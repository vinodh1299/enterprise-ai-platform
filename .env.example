# ==============================================================================
# Enterprise AI Operations Platform - Environment Configuration Example
# Copy this file to .env and fill in your local secrets. NEVER commit .env to Git!
# ==============================================================================

# Project & Environment
PROJECT_NAME="Enterprise AI Operations Platform"
ENVIRONMENT="development"  # development | staging | production
LOG_LEVEL="DEBUG"

# Security & Authentication
SECRET_KEY="change_this_to_a_secure_random_32_byte_string_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_ops_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Configuration (Caching & Task Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# AI Models & LLM API Credentials
# Replace with your API key when integrating LLM provider (Gemini / OpenAI / Anthropic)
LLM_PROVIDER="gemini" # gemini | openai | anthropic | ollama
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY=""

# Embeddings Model Configuration
EMBEDDING_MODEL_NAME="text-embedding-004"
EMBEDDING_DIMENSION=768
